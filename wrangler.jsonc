
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softmedia-liora",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GITHUB_OWNER": "soft-coachsmiley",
    "GITHUB_REPO": "softmedia-liora"
  }
}
